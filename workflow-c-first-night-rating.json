    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "// ===== Build Rating Request (Run Once for Each Item) =====\n// 1 item = แขก 1 คนที่เข้าพักคืนแรกวันนี้ → สร้างข้อความขอคะแนน 1–5 ดาว\n// ปุ่มส่ง postback: action=rate&booking_id=...&score=N (Workflow B เป็นคนรับ)\nconst b = $json;\nconst firstName = String(b.full_name || '').trim().split(/\\s+/)[0] || 'ลูกค้า';\nconst LABEL = { 5: 'ดีมาก', 4: 'ดี', 3: 'พอใช้', 2: 'ไม่ค่อยดี', 1: 'ควรปรับปรุง' };\nconst data = (n) => `action=rate&booking_id=${encodeURIComponent(b.booking_id)}&score=${n}`;\nconst action = (n, label) => ({ type: 'postback', label, data: data(n), displayText: `ให้คะแนน ${n} ดาว` });\n\nconst message = {\n  type: 'flex',\n  altText: 'คืนแรกเป็นอย่างไรบ้างคะ? ให้คะแนนความพึงพอใจ 1–5 ดาว',\n  contents: {\n    type: 'bubble',\n    size: 'kilo',\n    body: {\n      type: 'box', layout: 'vertical', spacing: 'md', paddingAll: '18px',\n      contents: [\n        { type: 'text', text: 'คืนแรกเป็นอย่างไรบ้างคะ 🌙', weight: 'bold', size: 'lg', color: '#16161A', wrap: true },\n        { type: 'text', size: 'sm', color: '#5C5850', wrap: true,\n          text: `สวัสดีค่ะคุณ${firstName}${b.room_number ? ' ห้อง ' + b.room_number : ''}\\nช่วยให้คะแนนความพึงพอใจหน่อยนะคะ ถ้ามีอะไรไม่สะดวก เราจะรีบดูแลทันที` },\n        {\n          type: 'box', layout: 'horizontal', spacing: 'xs', margin: 'md',\n          // ใช้ box ที่กดได้แทน button (button มี padding ในตัว → ตัวเลขโดนตัดเป็น \"...\")\n          contents: [1, 2, 3, 4, 5].map((n) => ({\n            type: 'box', layout: 'vertical', flex: 1, height: '44px', justifyContent: 'center',\n            cornerRadius: 'md', backgroundColor: n >= 4 ? '#B08D3E' : '#EFEAE0',\n            action: action(n, String(n)),\n            contents: [{ type: 'text', text: String(n), align: 'center', weight: 'bold', size: 'lg',\n              color: n >= 4 ? '#FFFFFF' : '#16161A' }],\n          })),\n        },\n        { type: 'text', text: '1 = ควรปรับปรุง · 5 = ดีมาก', size: 'xxs', color: '#8A8578', align: 'center' },\n      ],\n    },\n  },\n  // Quick Reply แสดงเหนือคีย์บอร์ด (หายไปเมื่อมีข้อความใหม่ แต่ปุ่มในการ์ดยังกดได้)\n  quickReply: { items: [5, 4, 3, 2, 1].map((n) => ({ type: 'action', action: action(n, `${n} ⭐ ${LABEL[n]}`) })) },\n};\n\nreturn { json: { booking_id: b.booking_id, push_body: { to: b.line_user_id, messages: [message] } } };\n"
      },
      "id": "48337d67-7924-50e0-88dd-0cca490bed3a",
      "name": "Build Rating Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
