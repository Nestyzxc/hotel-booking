      "id": "555ce84a-7c99-5843-8b0a-312fc64af4b1",
      "name": "Read Messages",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.7,
      "position": [
        660,
        300
      ],
      "alwaysOutputData": true,
      "executeOnce": true
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// ===== Build Prompt (Run Once for All Items) =====\n// แขกที่เช็กเอาต์แล้ว + ยังไม่มี preference_tags → รวมข้อความแชทของแขกคนนั้นเป็นข้อความเดียว\nconst MAX_PER_RUN = 5;          // จำกัดต่อรอบ กันชนโควตา Gemini ฟรี\nconst MAX_CHARS = 3000;\n// ข้อความจากปุ่มเมนู ไม่ใช่ความชอบของแขก → ตัดทิ้ง\nconst IGNORE = new Set(['การจองของฉัน', 'แจ้งปัญหา', 'ข้อมูลโรงแรม', 'ติดต่อพนักงาน']);\n\nconst messages = $('Read Messages').all().map((i) => i.json).filter((m) => m.line_user_id && m.text);\nconst mask = (t) => String(t)\n  .replace(/[\\w.+-]+@[\\w-]+\\.[\\w.]+/g, '[email]')      // อีเมล\n  .replace(/(\\+?66|0)[\\d\\s-]{8,11}\\d/g, '[phone]');    // เบอร์โทร\n\nconst out = [];\nfor (const it of $('Checked-out Without Tags').all().slice(0, MAX_PER_RUN)) {\n  const b = it.json;\n  const texts = [];\n  for (const m of messages) {\n    if (m.line_user_id !== b.line_user_id) continue;\n    if (m.booking_id && m.booking_id !== b.booking_id) continue;   // ข้อความของการจองอื่น\n    if (m.direction && m.direction !== 'in') continue;\n    const t = String(m.text).trim();\n    if (!t || IGNORE.has(t) || /^\\[[a-z]+\\]$/.test(t)) continue;  // ปุ่มเมนู / [sticker] / [image]\n    if (!texts.includes(t)) texts.push(mask(t));\n  }\n  let joined = texts.map((t) => '- ' + t).join('\\n');\n  if (joined.length > MAX_CHARS) joined = joined.slice(-MAX_CHARS);   // เก็บข้อความล่าสุด\n\n  out.push({\n    json: {\n      booking_id: b.booking_id,\n      message_count: texts.length,\n      has_messages: texts.length > 0,\n      prompt: texts.length ? `ข้อความของแขกระหว่างเข้าพัก:\\n${joined}` : '',\n      preference_tags: texts.length ? '' : '-',   // \"-\" = ตรวจแล้วแต่ไม่มีข้อมูล (จะได้ไม่วนมาทำซ้ำ)\n    },\n    pairedItem: { item: 0 },\n  });\n}\nreturn out;\n"
      },
      "id": "b9fb7a87-561a-5e8c-9284-79ad36347e4d",
      "name": "Build Prompt",
