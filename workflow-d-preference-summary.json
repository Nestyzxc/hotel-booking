    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// ===== Parse Tags (Run Once for All Items) =====\n// แปลงคำตอบ Gemini → \"tag1,tag2\" (มี fallback ถ้า JSON พัง)\nconst out = [];\n$input.all().forEach((it, i) => {\n  const src = $('Build Prompt').itemMatching(i).json;\n  if (it.json.error) return;              // Gemini error (เช่นโควตาเต็ม) → ข้าม รอบหน้าลองใหม่\n\n  const raw = (it.json.content?.parts || []).map((p) => p.text || '').join('').trim();\n  let tags = null;\n  const tryParse = (s) => { try { const j = JSON.parse(s); return Array.isArray(j) ? j : j.tags; } catch { return null; } };\n\n  // 1) JSON ตรง ๆ  2) ตัด ```json ... ``` ออก  3) หา {...} ก้อนแรก\n  tags = tryParse(raw)\n      ?? tryParse(raw.replace(/^```(?:json)?\\s*/i, '').replace(/\\s*```$/, ''))\n      ?? tryParse((raw.match(/\\{[\\s\\S]*\\}/) || [''])[0]);\n  // 4) สุดท้าย: แยกบรรทัดที่ขึ้นต้นด้วย - หรือ •\n  if (!Array.isArray(tags)) tags = raw.split('\\n').filter((l) => /^\\s*[-•*]\\s+/.test(l)).map((l) => l.replace(/^\\s*[-•*]\\s+/, ''));\n\n  const clean = [...new Set(tags\n    .filter((t) => typeof t === 'string')\n    .map((t) => t.replace(/[,\\n\"]/g, ' ').replace(/\\s+/g, ' ').trim().slice(0, 40))\n    .filter(Boolean))].slice(0, 5);\n\n  out.push({ json: { booking_id: src.booking_id, line_user_id: src.line_user_id || '', preference_tags: clean.join(',') || '-', raw }, pairedItem: { item: i } });\n});\nreturn out;\n"
      },
