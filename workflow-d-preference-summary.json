    {
      "parameters": {
        "resource": "text",
        "operation": "message",
        "modelId": {
          "__rl": true,
          "value": "models/gemini-3.5-flash-lite",
          "mode": "id"
        },
        "messages": {
          "values": [
            {
              "content": "={{ $json.prompt }}",
              "role": "user"
            }
          ]
        },
        "simplify": true,
        "jsonOutput": true,
        "builtInTools": {},
        "options": {
          "systemMessage": "คุณคือผู้ช่วยของโรงแรม หน้าที่คือสรุป \"ความชอบและความต้องการ\" ของแขกจากข้อความแชทระหว่างเข้าพัก เพื่อให้โรงแรมเตรียมบริการได้ตรงใจในการเข้าพักครั้งถัดไป\nกติกา:\n1. ตอบเป็น JSON เท่านั้น รูปแบบ {\"tags\": [\"...\", \"...\"]} ห้ามมีข้อความอื่น\n2. แต่ละ tag เป็นภาษาไทย สั้น กระชับ ไม่เกิน 6 คำ เช่น \"ชอบห้องเงียบ\", \"ไม่เอาหมอนขนเป็ด\", \"ขอเช็กเอาต์ช้า\"\n3. สูงสุด 5 tags เฉพาะสิ่งที่นำไปใช้บริการครั้งหน้าได้ (ห้อง ที่นอน อาหาร เวลา การเดินทาง ความชอบส่วนตัว)\n4. ห้ามใส่ชื่อ เบอร์โทร อีเมล หรือข้อมูลส่วนตัว ห้ามเดาสิ่งที่แขกไม่ได้พูด\n5. ถ้าข้อมูลไม่พอ ให้ตอบ {\"tags\": []}",
          "temperature": 0.2
        }
      },
      "id": "c8ba05e1-70b8-5f45-a201-6755b4313cec",
      "name": "Summarize with Gemini",
      "type": "@n8n/n8n-nodes-langchain.googleGemini",
      "typeVersion": 1.2,
      "position": [
        1320,
        200
      ],
      "onError": "continueRegularOutput"
