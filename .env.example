# คัดลอกเป็น .env (ไฟล์ .env ถูก .gitignore ไว้แล้ว ห้าม commit)
#   cp .env.example .env

# โดเมนคงที่ของ ngrok (Dashboard > Domains) ไม่ต้องมี https:// และ / ปิดท้าย
# ต้องตรงกับ N8N_BASE_URL ใน config.js
NGROK_DOMAIN=your-domain.ngrok-free.dev

# ngrok Dashboard > Your Authtoken
NGROK_AUTHTOKEN=
